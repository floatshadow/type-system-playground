opam-version: "2.0"
tags: ["aara"]
depends: [
  "ocaml" {>= "5.0"}
  "core"
  "dune" {>= "3.3"}
  "cmdliner"
  "menhir"
  "mlgmpidl"
  "ppx_jane"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
